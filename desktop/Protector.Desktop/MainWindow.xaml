<Window x:Class="Protector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:res="clr-namespace:Protector.Desktop.Resources"
        Title="{x:Static res:Strings.ProductName}"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgApp}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource BgApp}">
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="38" Background="{DynamicResource BgDeep}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
              <Canvas Width="24" Height="24">
                <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Fill="{DynamicResource AccentBg}"
                      Data="M12,2 L4,5.5 V12.5 C4,17.3 7.4,21.8 12,23 C16.6,21.8 20,17.3 20,12.5 V5.5 Z"/>
                <Path Stroke="{DynamicResource AccentSoft}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M9,12 L11,14 L15,10"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="{x:Static res:Strings.ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}" Margin="0,0,6,0"/>
            <TextBlock x:Name="EngineStatusText" Text="{x:Static res:Strings.EngineReady}" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Static res:Strings.EngineLocal}" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WinCtrl}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{x:Static res:Strings.TooltipMinimize}"/>
            <Button x:Name="MaxBtn" Style="{StaticResource WinCtrl}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{x:Static res:Strings.TooltipMaximize}"/>
            <Button x:Name="CloseBtn" Style="{StaticResource WinCtrl}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{x:Static res:Strings.TooltipClose}"
                    MouseEnter="CloseBtn_MouseEnter" MouseLeave="CloseBtn_MouseLeave"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="194"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
              <StackPanel>
                <TextBlock FontSize="10" Foreground="{DynamicResource TextFaint}" FontFamily="Consolas" LineHeight="16">
                  <Run Text="{x:Static res:Strings.EnginePrefix}"/><Run x:Name="SidebarEngineVer" Text="—" Foreground="{DynamicResource Accent}"/>
                </TextBlock>
                <TextBlock FontSize="9" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" Margin="0,6,0,0"
                           Text="{x:Static res:Strings.ProductName}"/>
              </StackPanel>
            </Border>

            <StackPanel Margin="8,14,8,10">
              <Button x:Name="NavHarden" Style="{StaticResource NavButtonActive}" Click="Nav_Click" Tag="harden">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="🛡" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Nav_Harden}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static res:Strings.Nav_HardenSub}" FontSize="10" FontFamily="Consolas" Opacity="0.75"/>
                  </StackPanel>
                </StackPanel>
              </Button>
              <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="history">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⏱" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Nav_History}" FontSize="12"/>
                    <TextBlock Text="{x:Static res:Strings.Nav_HistorySub}" FontSize="10" FontFamily="Consolas" Opacity="0.65"/>
                  </StackPanel>
                </StackPanel>
              </Button>
              <Button x:Name="NavReports" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="reports">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="📄" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Nav_Reports}" FontSize="12"/>
                    <TextBlock Text="{x:Static res:Strings.Nav_ReportsSub}" FontSize="10" FontFamily="Consolas" Opacity="0.65"/>
                  </StackPanel>
                </StackPanel>
              </Button>
              <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="settings">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⚙" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Nav_Settings}" FontSize="12"/>
                    <TextBlock Text="{x:Static res:Strings.Nav_SettingsSub}" FontSize="10" FontFamily="Consolas" Opacity="0.65"/>
                  </StackPanel>
                </StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1"/>
      </Grid>
    </DockPanel>
  </Border>
</Window>
