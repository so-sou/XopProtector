<UserControl x:Class="Protector.Desktop.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Protector.Desktop.Resources"
             Background="{DynamicResource BgApp}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,1,0" Padding="8,16">
      <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Settings_Title}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextDim}"
                   Margin="8,0,8,10"/>
        <Button x:Name="TabAppearance" Content="{x:Static res:Strings.Settings_TabAppearance}" Style="{StaticResource NavButtonActive}"
                Click="Tab_Click" Tag="appearance" Margin="0,0,0,2"/>
        <Button x:Name="TabLanguage" Content="{x:Static res:Strings.Settings_TabLanguage}" Style="{StaticResource NavButton}"
                Click="Tab_Click" Tag="language" Margin="0,0,0,2"/>
        <Button x:Name="TabAbout" Content="{x:Static res:Strings.Settings_TabAbout}" Style="{StaticResource NavButton}"
                Click="Tab_Click" Tag="about" Margin="0,0,0,2"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Style="{StaticResource ThinScrollViewer}" Padding="32,24" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- Appearance -->
        <StackPanel x:Name="PanelAppearance">
          <TextBlock Text="{x:Static res:Strings.Settings_AppearanceTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="{x:Static res:Strings.Settings_AppearanceSub}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
          <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,12,0,16"/>

          <TextBlock Text="{x:Static res:Strings.Settings_Theme}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
          <UniformGrid Columns="2" MaxWidth="420" HorizontalAlignment="Left">
            <Button x:Name="ThemeDarkBtn" Content="{x:Static res:Strings.Settings_ThemeDark}" Margin="0,0,8,0" Padding="12,14" FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand" Click="ThemeDark_Click" BorderThickness="1"/>
            <Button x:Name="ThemeLightBtn" Content="{x:Static res:Strings.Settings_ThemeLight}" Margin="8,0,0,0" Padding="12,14" FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand" Click="ThemeLight_Click" BorderThickness="1"/>
          </UniformGrid>
          <TextBlock Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                     Text="{x:Static res:Strings.Settings_ThemeHint}"/>
        </StackPanel>

        <!-- Language -->
        <StackPanel x:Name="PanelLanguage" Visibility="Collapsed">
          <TextBlock Text="{x:Static res:Strings.Settings_LanguageTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="{x:Static res:Strings.Settings_LanguageSub}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
          <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,12,0,16"/>

          <UniformGrid Columns="3" MaxWidth="560" HorizontalAlignment="Left">
            <Button x:Name="LangSystemBtn" Content="{x:Static res:Strings.Settings_LangSystem}" Margin="0,0,8,0" Padding="12,14" FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand" Click="LangSystem_Click" BorderThickness="1"/>
            <Button x:Name="LangEnBtn" Content="{x:Static res:Strings.Settings_LangEn}" Margin="4,0,4,0" Padding="12,14" FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand" Click="LangEn_Click" BorderThickness="1"/>
            <Button x:Name="LangZhBtn" Content="{x:Static res:Strings.Settings_LangZh}" Margin="8,0,0,0" Padding="12,14" FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand" Click="LangZh_Click" BorderThickness="1"/>
          </UniformGrid>
          <TextBlock Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                     Text="{x:Static res:Strings.Settings_LanguageHint}"/>
        </StackPanel>

        <!-- About -->
        <StackPanel x:Name="PanelAbout" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="{x:Static res:Strings.Settings_AboutTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="{x:Static res:Strings.Settings_AboutSub}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
          <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,12,0,8"/>

          <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_Product}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ProductName}" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
          </Grid>
          <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_EngineJar}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="JarPathText" Grid.Column="1" Foreground="{DynamicResource AccentSoft}" FontSize="11"
                       FontFamily="Consolas" TextWrapping="Wrap"/>
          </Grid>
          <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_ShellFiles}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="ShellPathText" Grid.Column="1" Foreground="{DynamicResource TextMuted}" FontSize="11"
                       FontFamily="Consolas" TextWrapping="Wrap"/>
          </Grid>
          <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_Java}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="JavaPathText" Grid.Column="1" Foreground="{DynamicResource TextMuted}" FontSize="11"
                       FontFamily="Consolas" TextWrapping="Wrap"/>
          </Grid>
          <TextBlock Margin="0,20,0,0" FontSize="11" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                     Text="{x:Static res:Strings.Settings_AboutBlurb}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
