<UserControl x:Class="Protector.Desktop.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Protector.Desktop.Resources"
             Background="{DynamicResource BgApp}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- List -->
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Background="{DynamicResource BgDeep}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,14,14,12" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.Reports_Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="ListCountText" Text="0" FontSize="11" Foreground="{DynamicResource TextDim}"
                       Margin="0,4,0,0" FontFamily="Consolas"/>
          </StackPanel>
        </Border>
        <ScrollViewer Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <StackPanel x:Name="EmptyList" Margin="0,40,0,0" Visibility="Collapsed">
              <TextBlock Text="{x:Static res:Strings.Reports_Empty}" FontSize="12" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
              <TextBlock Text="{x:Static res:Strings.Reports_EmptyHint}" FontSize="10" Foreground="{DynamicResource TextFaint}"
                         HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <ItemsControl x:Name="ReportList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,11,16,11" Cursor="Hand" BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource BorderSoft}"
                          Background="{Binding RowBg}"
                          MouseLeftButtonUp="ReportItem_Click" Tag="{Binding}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding AppName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding TitleFg}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubLine}" FontSize="10" Foreground="{DynamicResource TextFaint}"
                                   FontFamily="Consolas" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScoreText}" FontSize="16" FontWeight="Bold"
                                   Foreground="{Binding ScoreBrush}" FontFamily="Consolas"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock Text="{x:Static res:Strings.Reports_ScoreUnit}" FontSize="9" Foreground="{Binding ScoreBrush}"
                                   VerticalAlignment="Bottom" Opacity="0.7" Margin="2,0,0,2"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Detail -->
    <Grid Grid.Column="1">
      <StackPanel x:Name="EmptyDetail" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{x:Static res:Strings.Reports_EmptyDetail}" FontSize="13" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
        <TextBlock Text="{x:Static res:Strings.Reports_EmptyDetailHint}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>

      <ScrollViewer x:Name="DetailScroll" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="28,22">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock x:Name="DetailMeta" FontSize="11" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" Margin="0,6,0,0"/>
              <TextBlock x:Name="DetailSize" FontSize="11" Foreground="{DynamicResource TextFaint}" FontFamily="Consolas" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Border Width="72" Height="72" CornerRadius="36" BorderThickness="3"
                      BorderBrush="{DynamicResource Accent}" Margin="0,0,18,0"
                      Background="{DynamicResource AccentBg}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="ScoreText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                             FontFamily="Consolas" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="ScoreLabel" FontSize="9" Foreground="{DynamicResource AccentSoft}"
                             HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,14,0" HorizontalAlignment="Center">
                  <TextBlock x:Name="PassText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Success}"
                             FontFamily="Consolas" HorizontalAlignment="Center"/>
                  <TextBlock Text="{x:Static res:Strings.Reports_Pass}" FontSize="10" Foreground="{DynamicResource SuccessMeta}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0" HorizontalAlignment="Center">
                  <TextBlock x:Name="WarnText" FontSize="20" FontWeight="Bold" Foreground="#FBBF24"
                             FontFamily="Consolas" HorizontalAlignment="Center"/>
                  <TextBlock Text="{x:Static res:Strings.Reports_Warn}" FontSize="10" Foreground="#F59E0B" HorizontalAlignment="Center" Opacity="0.85"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock x:Name="FailText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Danger}"
                             FontFamily="Consolas" HorizontalAlignment="Center"/>
                  <TextBlock Text="{x:Static res:Strings.Reports_Fail}" FontSize="10" Foreground="{DynamicResource DangerHoverFg}" HorizontalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Border Height="6" CornerRadius="3" Background="{DynamicResource BorderSoft}" Margin="0,0,0,20">
            <Grid x:Name="SummaryBar"/>
          </Border>

          <ItemsControl x:Name="CategoryList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,18">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="10,0,0,0"
                            VerticalAlignment="Center" Width="400"/>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="12,9" CornerRadius="7"
                                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" Margin="0,1,10,0"
                                    Background="{Binding IconBg}" BorderBrush="{Binding IconBorder}" BorderThickness="1.5"
                                    VerticalAlignment="Top">
                              <TextBlock Text="{Binding Icon}" FontSize="10" FontWeight="Bold"
                                         Foreground="{Binding IconFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                              <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextDim}"
                                         Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
            <Button Content="{x:Static res:Strings.Reports_OpenSizeReport}" Style="{StaticResource GhostButton}" Padding="12,8"
                    Click="OpenSizeReport_Click" Margin="0,0,8,0"/>
            <Button Content="{x:Static res:Strings.Reports_OpenOutput}" Style="{StaticResource PrimaryButton}" Padding="12,8"
                    Click="OpenOutput_Click"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
